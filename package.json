{
  "name": "ai-execution-router",
  "version": "1.0.0",
  "description": "A deterministic execution engine for LLM calls. One function: complete(). The router executes, the controller decides.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JediConcepts/ai-execution-router.git"
  },
  "homepage": "https://github.com/JediConcepts/ai-execution-router#readme",
  "bugs": "https://github.com/JediConcepts/ai-execution-router/issues",
  "keywords": [
    "llm",
    "ai",
    "router",
    "execution",
    "anthropic",
    "openai",
    "multi-provider",
    "governance",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "docs",
    "ARCHITECTURE.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.json && npm test && npm run build",
    "prepare": "npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "author": "Jedi Concepts (https://jediconcepts.com)"
}
